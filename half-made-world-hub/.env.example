# --- AI backend (optional) --------------------------------------------------
# Query Chat's explore/answer modes use one HTTP chat-completions endpoint
# (Groq by default). Without a key, explore falls back to the local keyword
# lookup — no AI required.

# --- HTTP backend (Explore / answer) ----------------------------------------
# Any OpenAI-compatible chat-completions endpoint. Groq is the default, so the
# only required value is an API key.
GROQ_API_KEY=your-groq-api-key

# Point Explore at a different HTTP provider instead.
# Local model via Ollama (no rate limits, runs offline):
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1
# AI_API_KEY=ollama
#
# OpenRouter (free models, no Groq token cap):
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# AI_API_KEY=your-openrouter-key
# AI_FALLBACK_MODELS=cohere/north-mini-code:free,minimax/minimax-m3.1-flash:free

# --- Fallback provider (optional) -------------------------------------------
# A SECOND endpoint tried when the primary cannot answer — its free tier is
# rate-limited, it is down, or the model returns nothing. The request then
# succeeds instead of failing. OpenRouter is the default; point it anywhere.
#
# The fallback only joins the chain when it has an API key of its own, so a
# server with a single key behaves exactly as it did before.
AI_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
AI_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_FALLBACK_API_KEY=your-openrouter-key
# Extra models to try on the fallback provider, in order.
# AI_FALLBACK_MODEL_CHAIN=cohere/north-mini-code:free,minimax/minimax-m3.1-flash:free

# --- Advanced toggles (both default to on) ---------------------------------
# AI_REASONING=true     # HTTP backend only: send reasoning_effort (Groq/gpt-oss only)
# AI_JSON_MODE=false    # HTTP backend only: disable response_format JSON mode
# AI_FALLBACK_MODELS=   # HTTP backend only: extra models to try on the PRIMARY provider

# --- Chapter code auto-push (default on) -----------------------------------
# Registering, editing, or deleting a chapter code saves it, regenerates
# client/public/snapshot.json, then commits server/data/chapter-codes.json and
# pushes it, so the deployed site can redeem the code. Needs the server to
# run from a git checkout with push access; without one the code is still
# saved and the push is only logged as skipped.
# AUTO_PUSH_CHAPTER_CODES=false
